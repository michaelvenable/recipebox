    "@fastify/multipart": "^10.1.6",
    "@recipebox/domain": "^0.0.0",
    "@recipebox/shared": "^0.0.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
