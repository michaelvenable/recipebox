{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/icons/*", "/.auth/*", "/*.{js,css,json,webmanifest,png,svg,ico,txt,woff,woff2,map}"]
  },
  "routes": [
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/list/*", "headers": { "Cache-Control": "no-cache", "Referrer-Policy": "no-referrer" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
