{
  "name": "recipebox",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build": "npm run build -w @recipebox/server",
    "dev:server": "npm run dev -w @recipebox/server",
    "dev:client": "npm run dev -w @recipebox/client",
    "start:server": "npm run start -w @recipebox/server",
    "cleanup:server": "npm run cleanup:start -w @recipebox/server",
    "test:int": "vitest run --config vitest.int.config.ts",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
